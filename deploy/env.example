# WARNING: Replace all CHANGE_ME values before deploying.
# Do not use placeholder passwords in production.
DATABASE_URL=postgres://ironclaw:CHANGE_ME@localhost:5432/ironclaw

# LLM backend (NEAR AI is optional; default in app is nearai unless overridden here)
LLM_BACKEND=openai

# OpenAI (recommended non-NEARAI setup)
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative)
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=CHANGE_ME
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible (alternative)
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=https://your-endpoint.example.com/v1
# LLM_API_KEY=CHANGE_ME
# LLM_MODEL=your-model

# Optional NEAR AI block (only if you intentionally use nearai)
# LLM_BACKEND=nearai
# NEARAI_SESSION_TOKEN=CHANGE_ME
# NEARAI_MODEL=claude-3-5-sonnet-20241022
# NEARAI_BASE_URL=https://cloud-api.near.ai
# NEARAI_AUTH_URL=https://private.near.ai
# NEARAI_API_MODE=chat_completions

# Agent
AGENT_NAME=ironclaw
CLI_ENABLED=false

# Web Gateway
GATEWAY_ENABLED=true
# 0.0.0.0 binds to all interfaces (required for Docker --network=host).
# Use 127.0.0.1 if running outside Docker or for local-only access.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
# On Railway you can omit GATEWAY_PORT and rely on the platform-provided PORT.
GATEWAY_AUTH_TOKEN=CHANGE_ME

# HTTP webhook channel (required for Slack Events API webhook delivery)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_WEBHOOK_SECRET=CHANGE_ME

# Slack channel secrets are stored in IronClaw's encrypted secrets store.
# Secret names expected by the bundled Slack channel:
# - slack_bot_token
# - slack_signing_secret

# Disabled for initial deploy
SANDBOX_ENABLED=false
HEARTBEAT_ENABLED=false
EMBEDDING_ENABLED=false
